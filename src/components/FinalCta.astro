---
import PorchLight from './PorchLight.astro';
import CtaPair from './CtaPair.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  text: string;
  audit?: string;
  auditHref?: string;
  // Hide the phone line on pages where the Google Business Profile section shows it just below.
  showPhone?: boolean;
}

const { title, text, audit = 'Free Audit', auditHref, showPhone = true } = Astro.props;
---
<section class="evening on-dark final-cta lightbox">
  <PorchLight w="900px" h="640px" />
  <div class="wrap">
    <span class="eyebrow">Get in touch</span>
    <h2>{title}</h2>
    <p>{text}</p>
    <CtaPair audit={audit} auditHref={auditHref} />
    {showPhone && <p class="phone-note">Prefer to talk it through? Call <a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>}
  </div>
</section>
