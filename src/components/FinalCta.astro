---
import PorchLight from './PorchLight.astro';
import CtaPair from './CtaPair.astro';

interface Props {
  title: string;
  text: string;
  audit?: string;
  auditHref?: string;
}

const { title, text, audit = 'Free Audit', auditHref } = Astro.props;
---
<section class="evening on-dark final-cta lightbox">
  <PorchLight w="900px" h="640px" />
  <div class="wrap">
    <h2>{title}</h2>
    <p>{text}</p>
    <CtaPair audit={audit} auditHref={auditHref} />
  </div>
</section>
