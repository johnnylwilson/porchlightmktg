---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  items: { q: string; a: string }[];
  eyebrow?: string;
  // Intro line, split around the phone number: [before, after]
  lede?: [string, string];
}

const { title, items, eyebrow, lede = ["Still have a question we didn't cover? Call", "and you'll get a straight answer."] } = Astro.props;
---
<section class="section">
  <div class="wrap split">
    <div class="sticky-col">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2>{title}</h2>
      <p class="lede">{lede[0]} <a href={`tel:${site.phoneHref}`}>{site.phone}</a> {lede[1]}</p>
    </div>
    <div class="faq">
      {items.map((f) => (
        <details>
          <summary><h3 class="faq-q">{f.q}</h3><span class="plus"><Icon name="plus" /></span></summary>
          <p set:html={f.a}></p>
        </details>
      ))}
    </div>
  </div>
</section>
