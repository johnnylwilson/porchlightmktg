---
// Illustration: a Google Maps style result with "Your Business" lit up at the top.
import Icon from './Icon.astro';
import Stars from './Stars.astro';
---
<div class="viz" role="img" aria-label="Illustration: a Google Maps style search where Your Business is the highlighted top result">
  <div class="viz-search"><Icon name="search" /><span><b>service near me</b></span></div>
  <div class="viz-map">
    <span class="pin" style="left:18%;top:58%"></span>
    <span class="pin" style="left:70%;top:24%"></span>
    <span class="pin" style="left:80%;top:66%"></span>
    <span class="pin pin--lit" style="left:44%;top:30%"></span>
  </div>
  <ul class="viz-results">
    <li class="is-lit">
      <div class="r-title"><span>Your Business</span><Stars /></div>
      <div class="r-meta">Open now &middot; Lake Mary, FL</div>
      <div class="r-meta">Local service business &middot; Serves nearby towns</div>
    </li>
    <li aria-hidden="true"><div class="bar" style="width:46%"></div><div class="bar" style="width:72%;height:7px"></div></li>
    <li aria-hidden="true"><div class="bar" style="width:46%"></div><div class="bar" style="width:72%;height:7px"></div></li>
  </ul>
</div>
