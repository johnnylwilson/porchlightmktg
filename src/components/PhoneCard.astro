---
// Illustration: a local business website on a phone.
import Stars from './Stars.astro';
---
<div class="viz-phone" role="img" aria-label="Illustration: a local business website on a phone with call and quote buttons and a short form">
  <div class="screen">
    <div class="s-top"><span class="s-logo">Your Business</span><span class="s-menu"></span></div>
    <div class="s-hero">
      <span class="s-h">Friendly, local service in Lake Mary</span>
      <div class="s-btns"><span>Free Quote</span><span>Call Now</span></div>
    </div>
    <div class="s-review"><Stars /><span>Loved by neighbors</span></div>
    <div class="s-form">
      <span class="lbl">Name</span><div class="f"></div>
      <span class="lbl">How can we help?</span><div class="f" style="height:38px"></div>
    </div>
  </div>
</div>
