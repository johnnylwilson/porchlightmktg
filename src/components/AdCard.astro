---
// Illustration: a sponsored Google result for "Your Business".
import Icon from './Icon.astro';
---
<div class="viz" role="img" aria-label="Illustration: a sponsored search result for Your Business at the top of Google">
  <div class="viz-search"><Icon name="search" /><span><b>service near me</b></span></div>
  <div class="viz-ad">
    <div class="lit">
      <span class="ad-label">Sponsored</span>
      <span class="ad-url">yourbusiness.com/services</span>
      <span class="ad-head">Your Business | Local, Friendly Service</span>
      <span class="ad-desc">Serving Lake Mary and nearby towns. Call today or request a quote online.</span>
      <div class="sitelinks"><span>Request a Quote</span><span>Our Services</span><span>Reviews</span></div>
    </div>
    <div class="viz-divider"></div>
    <div style="display:grid;gap:8px" aria-hidden="true"><div class="bar" style="width:40%;height:7px"></div><div class="bar" style="width:78%"></div><div class="bar" style="width:64%;height:7px"></div></div>
    <div style="display:grid;gap:8px;margin-top:6px" aria-hidden="true"><div class="bar" style="width:36%;height:7px"></div><div class="bar" style="width:70%"></div><div class="bar" style="width:58%;height:7px"></div></div>
  </div>
</div>
