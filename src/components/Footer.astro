---
import { site } from '../data/site';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/images/porchlight-wordmark.png" alt="Porchlight Marketing" width="640" height="161" loading="lazy" />
        <p class="footer-tagline">{site.tagline}</p>
        <p class="small">Local SEO, Google Ads, and web design for local businesses. Based in Lake Mary, Florida.</p>
      </div>
      <div class="footer-col">
        <h4>Get in touch</h4>
        <ul>
          <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
          <li><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} Porchlight Marketing. All rights reserved.</span>
      <span><a href="/privacy-policy">Privacy Policy</a> &middot; <a href="/terms-of-service">Terms of Service</a></span>
    </div>
  </div>
</footer>
