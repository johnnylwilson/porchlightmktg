---
import '../styles/global.css';
import Intro from '../components/Intro.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  // Which nav item is highlighted: home, local-seo, google-ads, website-design, portfolio, about, blog, contact
  current?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  // Share image (site path or full URL). Defaults to /images/og-image.jpg.
  image?: string;
  // Category of a post or project, added as article:section and article:tag.
  section?: string;
  // JSON-LD structured data for this page (see src/data/schema.ts)
  schema?: object | object[];
}

const { title, description, current, ogType = 'website', noindex = false, schema, image, section } = Astro.props;
const schemaList = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

// Canonical URL without .html or a trailing slash, matching how Vercel serves pages.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/';
const canonical = Astro.site ? new URL(path, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(image ?? '/images/og-image.jpg', Astro.site).href : undefined;
const fonts = 'https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,600&family=Playfair+Display:ital,wght@0,700;1,400;1,700&display=swap';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && !noindex && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Porchlight Marketing" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    {section && <meta property="article:section" content={section} />}
    {section && <meta property="article:tag" content={section} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Bump ?v= whenever the icons change so browsers fetch the new ones. -->
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png?v=2" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />

    <!-- Decide before first paint whether the porch light intro plays (once per session). -->
    <script is:inline>
      (function () {
        try {
          var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!reduce && sessionStorage.getItem('pl-intro') !== '1') {
            document.documentElement.classList.add('intro-on');
            sessionStorage.setItem('pl-intro', '1');
          }
        } catch (e) {}
      })();
    </script>

    {schemaList.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)}></script>)}
    <!-- Pages can add extra head tags here. -->
    <slot name="head" />
  </head>
  <body>
    <Intro />
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Header border once the page scrolls
      const header = document.querySelector('.site-header');
      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Mobile menu
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const panel = document.getElementById('mobile-panel');
      if (toggle && panel) {
        const openIcon = toggle.innerHTML;
        const closeIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>';
        toggle.addEventListener('click', () => {
          const opening = panel.hidden;
          panel.hidden = !opening;
          toggle.setAttribute('aria-expanded', String(opening));
          toggle.setAttribute('aria-label', opening ? 'Close menu' : 'Open menu');
          toggle.innerHTML = opening ? closeIcon : openIcon;
        });
      }

      // Services dropdown: click support for touch and keyboard
      document.querySelectorAll('.has-dropdown').forEach((dd) => {
        const btn = dd.querySelector('.dd-toggle');
        if (!btn) return;
        btn.addEventListener('click', () => {
          const on = !dd.classList.contains('is-open');
          dd.classList.toggle('is-open', on);
          btn.setAttribute('aria-expanded', String(on));
        });
        document.addEventListener('click', (e) => {
          if (!dd.contains(e.target as Node)) {
            dd.classList.remove('is-open');
            btn.setAttribute('aria-expanded', 'false');
          }
        });
      });

      // Scroll reveal: blocks below the fold fade up as they come into view.
      (() => {
        const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) return;
        const sel = '.section-head, .service-card, .reason, .feature, .how > li, .steps > li, .offer, .stat, .success-item, .value, .mv > div, .post-card, .work-card, .project-shot, .price-card, .faq details, .founder-photo, .founder .stack, blockquote, .deliver-list, .article-cta .box, .gbp .wrap > *';
        const fold = window.innerHeight * 0.92;
        const els = Array.from(document.querySelectorAll<HTMLElement>(sel)).filter((el) => el.getBoundingClientRect().top > fold);
        if (!els.length) return;
        document.documentElement.classList.add('reveal-ready');
        els.forEach((el) => {
          const group = Array.from(el.parentElement ? el.parentElement.children : []).filter((c) => c.matches(sel));
          el.style.setProperty('--rd', Math.min(Math.max(group.indexOf(el), 0), 4) * 80 + 'ms');
          el.classList.add('reveal');
        });
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const el = e.target as HTMLElement;
            el.classList.add('is-in');
            io.unobserve(el);
            // Hand control back to the normal styles (hover lifts and so on) once it has settled.
            setTimeout(() => { el.classList.remove('reveal', 'is-in'); el.style.removeProperty('--rd'); }, 1200);
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
      })();

      // Number roll: stat digits spin into place like an odometer when they scroll into view.
      (() => {
        const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) return;
        const build = () => {
          const els = Array.from(document.querySelectorAll<HTMLElement>('.stat-n, .founder-facts b, .project-metric')).filter((el) => /\d/.test(el.textContent || ''));
          if (!els.length) return;
          els.forEach((el) => {
            const text = (el.textContent || '').trim();
            // Measure each character in place so every digit cell keeps its real width.
            el.innerHTML = Array.from(text).map((ch) => '<span class="odo-m">' + ch + '</span>').join('');
            const widths = Array.from(el.querySelectorAll('.odo-m')).map((m) => m.getBoundingClientRect().width);
            const wrap = document.createElement('span');
            wrap.className = 'odo';
            wrap.setAttribute('aria-hidden', 'true');
            let n = 0;
            Array.from(text).forEach((ch, i) => {
              if (/\d/.test(ch)) {
                const cell = document.createElement('span');
                cell.className = 'odo-digit';
                cell.style.width = widths[i] + 'px';
                const strip = document.createElement('span');
                strip.className = 'odo-strip';
                strip.dataset.to = String(10 + Number(ch));
                strip.style.setProperty('--od', n * 90 + 'ms');
                for (let k = 0; k < 20; k++) { const d = document.createElement('span'); d.textContent = String(k % 10); strip.appendChild(d); }
                cell.appendChild(strip); wrap.appendChild(cell); n++;
              } else {
                const c = document.createElement('span'); c.className = 'odo-char'; c.textContent = ch; wrap.appendChild(c);
              }
            });
            el.textContent = '';
            el.setAttribute('aria-label', text);
            el.appendChild(wrap);
          });
          const io = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              io.unobserve(e.target);
              e.target.querySelectorAll<HTMLElement>('.odo-strip').forEach((s) => { s.style.transform = 'translateY(calc(-' + s.dataset.to + ' * var(--oh)))'; });
            });
          }, { rootMargin: '0px 0px -10% 0px' });
          requestAnimationFrame(() => els.forEach((el) => io.observe(el)));
        };
        // Wait for the web fonts so the measured widths match the final text.
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(build); else build();
      })();

      // Lead forms: send to PUBLIC_FORM_ENDPOINT without leaving the page.
      const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT;
      document.querySelectorAll<HTMLFormElement>('form[data-lead-form]').forEach((form) => {
        const ok = form.querySelector<HTMLElement>('.form-success');
        const err = form.querySelector<HTMLElement>('.form-error');
        const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (ok) ok.hidden = true;
          if (err) err.hidden = true;
          if (!endpoint) {
            console.warn('PUBLIC_FORM_ENDPOINT is not set, so form submissions have nowhere to go. See README.');
            if (err) err.hidden = false;
            return;
          }
          const label = btn?.textContent ?? '';
          if (btn) { btn.disabled = true; btn.textContent = 'Sending...'; }
          try {
            const res = await fetch(endpoint, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
            if (!res.ok) throw new Error(`Form endpoint returned ${res.status}`);
            form.reset();
            if (ok) ok.hidden = false;
          } catch (error) {
            console.error(error);
            if (err) err.hidden = false;
          } finally {
            if (btn) { btn.disabled = false; btn.textContent = label; }
          }
        });
      });
    </script>
  </body>
</html>
