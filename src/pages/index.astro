---
import BaseLayout from '../layouts/BaseLayout.astro';
import { businessSchema, websiteSchema } from '../data/schema';
import PorchLight from '../components/PorchLight.astro';
import CtaPair from '../components/CtaPair.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import FinalCta from '../components/FinalCta.astro';
import MapCard from '../components/MapCard.astro';
import GbpSection from '../components/GbpSection.astro';
import { site } from '../data/site';
import { seoFor } from '../data/seo';

const seo = seoFor('home');

const serviceCards = [
  { slug: 'local-seo', name: 'Local SEO', icon: 'pin', d: 'Make your business easier to find online, so nearby clients know who to call when they need what you do.' },
  { slug: 'google-ads', name: 'Google Ads', icon: 'ad', d: 'Put your services in front of people who are searching right now, and start getting calls without waiting months.' },
  { slug: 'website-design', name: 'Web Design', icon: 'layout', d: 'A professional website that builds trust, explains your services clearly, and makes it easy to get in touch.' },
];

const reasons = [
  { icon: 'target', t: 'Precise', d: 'Your marketing is aimed at the exact services you want more of and the areas you want to work in.' },
  { icon: 'shield', t: 'Credible', d: 'I turn your business into a strong, professional online presence that nearby clients can find.' },
  { icon: 'pin', t: 'Local', d: 'Everything focuses on the cities where you operate and actually want to win more work.' },
  { icon: 'chat', t: 'Plainspoken', d: 'You get clear explanations and honest reporting. No jargon, no big promises, and no surprises.' },
];
---
<BaseLayout title={seo.title} description={seo.description} current="home" schema={[businessSchema(), websiteSchema()]}>
  <section class="hero hero--dark evening on-dark lightbox">
    <PorchLight x="72%" w="820px" h="760px" />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="hero-meta">
          <span><Icon name="pin" />Local SEO</span>
          <span><Icon name="ad" />Google Ads</span>
          <span><Icon name="layout" />Web Design</span>
        </div>
        <h1>Marketing for local businesses.</h1>
        <p class="lede">{site.positioning}</p>
        <CtaPair />
      </div>
      <div class="hero-visual">
        <MapCard />
      </div>
    </div>
  </section>

  <section class="section section--boards">
    <div class="wrap">
      <SectionHead eyebrow="Services" title="Three ways to help the right people find you" center />
      <div class="grid-3">
        {serviceCards.map((c) => (
          <a class="service-card" href={`/${c.slug}`}>
            <span class="icon"><Icon name={c.icon} /></span>
            <h3>{c.name}</h3>
            <p>{c.d}</p>
            <span class="text-link">Learn more <span>&rarr;</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>


  <section class="section">
    <div class="wrap split">
      <div class="sticky-col">
        <span class="eyebrow">Why Porchlight</span>
        <h2>Marketing that keeps the focus close to home</h2>
        <p class="lede">I put my time into the things that bring in work: showing up when people nearby search, and making it easy for them to reach you.</p>
        <div class="cta-before"><CtaPair /></div>
      </div>
      <div class="reason-list">
        {reasons.map((r) => (
          <div class="reason"><span class="icon"><Icon name={r.icon} /></span><div><h3>{r.t}</h3><p>{r.d}</p></div></div>
        ))}
      </div>
      <div class="cta-after"><CtaPair /></div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap">
      <SectionHead title="Getting started is simple" intro="Most people hear about me from someone they trust. Here is what happens after you reach out." center />
      <ol class="how">
        <li><h3>Free audit</h3><p>I review your website, Google listing, and how you show up in local searches, then walk you through what I found.</p></li>
        <li><h3>A plan for your business</h3><p>We agree on the services, areas, and kinds of work to focus on, and I send a clear scope and estimate.</p></li>
        <li><h3>Do the work and measure it</h3><p>I publish the updates or launch your campaign, then track how you're showing up so you know what the work is doing.</p></li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap bio home-about">
      <div class="home-about-photo"><img class="bio-photo" src="/images/johnny-wilson.jpg" alt="Johnny Wilson, founder of Porchlight Marketing" width="680" height="850" loading="lazy" decoding="async" /></div>
      <div class="stack">
        <span class="eyebrow">About me</span>
        <h2>Johnny Wilson</h2>
        <p>I'm Johnny Wilson, founder of Porchlight Marketing in Lake Mary. I've spent more than seven years building websites, managing Google Ads, and improving local search visibility for small businesses, and I work directly with every client from the first audit onward.</p>
        <a class="text-link" href="/about">More about me <span>&rarr;</span></a>
      </div>
    </div>
  </section>

  <FinalCta title="Ready to make a name around town?" text="Request a free audit to see how your business shows up online and where there's room to improve. If you'd like to talk through your goals in person, let's meet for coffee." />

  <GbpSection seoKey="home" />
</BaseLayout>
