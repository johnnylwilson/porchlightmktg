---
import BaseLayout from '../layouts/BaseLayout.astro';
import PorchLight from '../components/PorchLight.astro';
import CtaPair from '../components/CtaPair.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import Testimonial from '../components/Testimonial.astro';
import FinalCta from '../components/FinalCta.astro';
import MapCard from '../components/MapCard.astro';
import GbpSection from '../components/GbpSection.astro';
import { site, testimonials } from '../data/site';
import { seoFor } from '../data/seo';

const seo = seoFor('home');

const serviceCards = [
  { slug: 'local-seo', name: 'Local SEO', icon: 'pin', d: 'Make your business easier to find online, so nearby clients know who to call when they need what you do.' },
  { slug: 'google-ads', name: 'Google Ads', icon: 'ad', d: 'Put your services in front of people who are searching right now, and start getting calls without waiting months.' },
  { slug: 'website-design', name: 'Web Design', icon: 'layout', d: 'A professional website that builds trust, explains your services clearly, and makes it easy to get in touch.' },
];

const reasons = [
  { icon: 'target', t: 'Precise', d: 'Your marketing is aimed at the exact services you want more of and the areas you want to work in.' },
  { icon: 'shield', t: 'Credible', d: 'We turn your business into a strong, professional online presence that nearby clients can find.' },
  { icon: 'pin', t: 'Local', d: 'Everything focuses on the cities where you operate and actually want to win more work.' },
  { icon: 'chat', t: 'Plainspoken', d: 'You get clear explanations and honest reporting. No jargon, no big promises, and no surprises.' },
];
---
<BaseLayout title={seo.title} description={seo.description} current="home">
  <section class="hero lightbox">
    <PorchLight x="72%" w="820px" h="760px" />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="hero-meta">
          <span><Icon name="pin" />Local SEO</span>
          <span><Icon name="ad" />Google Ads</span>
          <span><Icon name="layout" />Web Design</span>
        </div>
        <h1>Marketing for local businesses.</h1>
        <p class="lede">{site.positioning}</p>
        <CtaPair />
      </div>
      <div class="hero-visual">
        <MapCard />
      </div>
    </div>
  </section>

  <section class="section--tight" aria-label="The short version">
    <div class="wrap">
      <div class="short-version">
        <div>
          <span class="label">What we do</span>
          <p class="big">Help you get found on Google and get more inquiries.</p>
          <p>Through local SEO, Google Ads, and websites built to bring in calls.</p>
        </div>
        <div>
          <span class="label">Who we work with</span>
          <p class="big">Local service businesses that run on calls, bookings, and quote requests.</p>
          <p>If customers find you on Google before they call, we can help.</p>
        </div>
        <div>
          <span class="label">How to reach us</span>
          <p class="big"><a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
          <p>Or <a href="/contact#audit">request a free audit</a> and we'll take a look at where you stand.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow="Our services" title="Three ways to help the right people find you" center />
      <div class="grid-3">
        {serviceCards.map((c) => (
          <a class="service-card" href={`/${c.slug}`}>
            <span class="icon"><Icon name={c.icon} /></span>
            <h3>{c.name}</h3>
            <p>{c.d}</p>
            <span class="text-link">Learn more <span>&rarr;</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Testimonial t={testimonials.david} bg="paper" />

  <section class="section">
    <div class="wrap split">
      <div class="sticky-col">
        <span class="eyebrow">Why Porchlight</span>
        <h2>Marketing that keeps the focus close to home</h2>
        <p class="lede">We work with local businesses on the things that bring in work: showing up when people nearby search, and making it easy for them to reach you.</p>
        <div class="cta-before"><CtaPair /></div>
      </div>
      <div class="reason-list">
        {reasons.map((r) => (
          <div class="reason"><span class="icon"><Icon name={r.icon} /></span><div><h3>{r.t}</h3><p>{r.d}</p></div></div>
        ))}
      </div>
      <div class="cta-after"><CtaPair /></div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap">
      <SectionHead eyebrow="How it works" title="Getting started is simple" intro="Most people hear about us from someone they trust. Here is what happens after you reach out." center />
      <ol class="how">
        <li><h3>Free audit</h3><p>We review your website, Google listing, and how you show up in local searches, then walk you through what we found.</p></li>
        <li><h3>A plan for your business</h3><p>Together we map out your services, the towns you serve, and the work you want more of. You get a clear scope and estimate.</p></li>
        <li><h3>Steady work and clear reports</h3><p>We do the work and keep you posted with simple monthly reports on where you show up and how many people reach out.</p></li>
      </ol>
    </div>
  </section>

  <section class="section section--boards">
    <div class="wrap">
      <SectionHead eyebrow="What we stand for" title="The values behind the work" intro="We take our role seriously and hold ourselves to these standards with every client." center />
      <div class="values">
        <div class="value"><h3>Integrity</h3><p>We promote your business with honest tactics and transparent reporting, so you always know where you stand.</p></div>
        <div class="value"><h3>Stewardship</h3><p>Your name and reputation are treated with care. We grow your visibility with the long term in mind.</p></div>
        <div class="value"><h3>Focus</h3><p>We stay focused on your local presence, so you show up where nearby customers are searching.</p></div>
      </div>
    </div>
  </section>

  <FinalCta title="Ready to make a name around town?" text="Partner with a team that understands local search and builds visibility where it counts. Start with a free audit, or just reach out and tell us about your business." showPhone={false} />

  <GbpSection seoKey="home" />
</BaseLayout>
