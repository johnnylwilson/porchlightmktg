---
import BaseLayout from '../layouts/BaseLayout.astro';
import PorchLight from '../components/PorchLight.astro';
import CtaPair from '../components/CtaPair.astro';
import { seoFor } from '../data/seo';

const seo = seoFor('not-found');
---
<BaseLayout title={seo.title} description={seo.description} noindex>
  <section class="page-hero lightbox notfound">
    <PorchLight w="760px" h="560px" />
    <div class="wrap">
      <h1 class="eyebrow">Page not found</h1>
      <h2 class="display">The light's on, but this page isn't here</h2>
      <p class="lede">The page you're looking for may have moved. Try one of our services, or get in touch and we'll point you in the right direction.</p>
      <CtaPair />
      <p><a class="text-link" href="/">Back to the home page <span>&rarr;</span></a></p>
    </div>
  </section>
</BaseLayout>
