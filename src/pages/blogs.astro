---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSchema } from '../data/schema';
import PorchLight from '../components/PorchLight.astro';
import PostCard from '../components/PostCard.astro';
import FinalCta from '../components/FinalCta.astro';
import { seoFor } from '../data/seo';

const seo = seoFor('blog');
const serviceOrder = ['Local SEO', 'Google Ads', 'Web Design'];
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => serviceOrder.indexOf(a.data.service) - serviceOrder.indexOf(b.data.service) || a.data.order - b.data.order,
);
---
<BaseLayout title={seo.title} description={seo.description} current="blog" schema={pageSchema('CollectionPage', '/blogs', 'blog')}>
  <section class="page-hero lightbox">
    <PorchLight w="760px" h="520px" />
    <div class="wrap">
      <h1 class="eyebrow">Our blog</h1>
      <h2 class="display">Straight answers for local businesses</h2>
      <p class="lede">Plain-language guides on getting found on Google, running ads that bring in calls, and building a website people trust.</p>
    </div>
  </section>

  <section class="section section--after-hero">
    <div class="wrap">
      <div class="post-grid">
        {posts.map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>

  <FinalCta title="Have a question these posts didn't answer?" text="Reach out and ask, or start with a free audit for answers specific to your business." />
</BaseLayout>
